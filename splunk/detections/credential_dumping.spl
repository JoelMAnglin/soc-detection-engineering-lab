index=edr sourcetype="crowdstrike:events" event_simpleName=ProcessRollup2
| eval command=lower(CommandLine)
| where like(command,"%lsass%") OR Technique="T1003.001"
| stats count values(CommandLine) AS commands values(SHA256HashData) AS hashes BY aid ComputerName UserName
| eval rule_id="SOC-EDR-002", severity="critical", mitre_technique="T1003.001"

